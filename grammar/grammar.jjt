    { return cmd; }
}

CommandSymbol SelectCommand() : {
    Collection<KeyTokenSymbol<?>> keys = null;
    KeyTokenSymbol<?> key = null;
    Token record = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp = null;
}
{
    <SELECT>
    (
        // Bracketed record collection (no keys) — select [1, 2, 3]
        LOOKAHEAD(<OPEN_BRACKET> <NUMERIC>)
        records=RecordCollection() (timestamp=TimestampReadCommand())?
        {
            return new SelectSymbol(null, records, timestamp);
        }
      |
        // Key collection + preposition/where — select [name, age] from 1 / select name, age from 1
        LOOKAHEAD(KeyCollection() (<FROM> | <IN> | <WITHIN> | <WHERE>))
        keys=KeyCollection()
        (
            LOOKAHEAD(2)
            (<FROM> | <IN> | <WITHIN>)
            (
                LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
                records=RecordCollection() (timestamp=TimestampReadCommand())? (Order())? (Page())?
                {
                    return new SelectSymbol(keys, records, timestamp);
                }
              |
                record=<NUMERIC> (timestamp=TimestampReadCommand())? (Order())? (Page())?
                {
                    return new SelectSymbol(keys, Long.parseLong(record.image), timestamp);
                }
            )
          |
            <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
            {
                return new SelectSymbol(keys, timestamp);
            }
        )
      |
        // Single key + preposition/where — select name from 1
        LOOKAHEAD(Key() (<FROM> | <IN> | <WITHIN> | <WHERE>))
        key=Key() {
            keys = new ArrayList<KeyTokenSymbol<?>>();
            keys.add(key);
        }
        (
            LOOKAHEAD(2)
            (<FROM> | <IN> | <WITHIN>)
            (
                LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
                records=RecordCollection() (timestamp=TimestampReadCommand())? (Order())? (Page())?
                {
                    return new SelectSymbol(keys, records, timestamp);
                }
              |
                record=<NUMERIC> (timestamp=TimestampReadCommand())? (Order())? (Page())?
                {
                    return new SelectSymbol(keys, Long.parseLong(record.image), timestamp);
                }
            )
          |
            <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
            {
                return new SelectSymbol(keys, timestamp);
            }
        )
      |
        // No keys + where — select where active = true
        <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
        {
            return new SelectSymbol(null, timestamp);
        }
      |
        // Bracketless record collection (no keys) — select 1, 2, 3
        LOOKAHEAD(<NUMERIC> <COMMA>)
        records=RecordCollection() (timestamp=TimestampReadCommand())?
        {
            return new SelectSymbol(null, records, timestamp);
        }
      |
        // Single record (no keys) — select 1
        record=<NUMERIC> (timestamp=TimestampReadCommand())?
        {
            return new SelectSymbol(null, Long.parseLong(record.image), timestamp);
        }
    )
}

CommandSymbol GetCommand() : {
    KeyTokenSymbol<?> key = null;
    Collection<KeyTokenSymbol<?>> keys = null;
    Token record = null;
    Collection records = null;
    TimestampSymbol timestamp = null;
}
{
    <GET>
    (
        LOOKAHEAD(KeyCollection() <WHERE>)
        keys=KeyCollection() <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
        { return new GetSymbol(keys, timestamp); }
      |
        // Single key + where — get name where age > 30
        LOOKAHEAD(Key() <WHERE>)
        key=Key() <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
        {
            keys = new ArrayList<KeyTokenSymbol<?>>();
            keys.add(key);
            return new GetSymbol(keys, timestamp);
        }
      |
        LOOKAHEAD(KeyCollection() (<FROM> | <IN> | <WITHIN>))
        keys=KeyCollection() (<FROM> | <IN> | <WITHIN>)
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection() (timestamp=TimestampReadCommand())? (Order())? (Page())?
            { return new GetSymbol(keys, records, timestamp); }
          |
            record=<NUMERIC> (timestamp=TimestampReadCommand())? (Order())? (Page())?
            { return new GetSymbol(keys, Long.parseLong(record.image), timestamp); }
        )
      |
        LOOKAHEAD(Key() (<FROM> | <IN> | <WITHIN>))
        key=Key() (<FROM> | <IN> | <WITHIN>)
        {
            keys = new ArrayList<KeyTokenSymbol<?>>();
            keys.add(key);
        }
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection() (timestamp=TimestampReadCommand())? (Order())? (Page())?
            { return new GetSymbol(keys, records, timestamp); }
          |
            record=<NUMERIC> (timestamp=TimestampReadCommand())? (Order())? (Page())?
            { return new GetSymbol(keys, Long.parseLong(record.image), timestamp); }
        )
      |
        // No keys + where — get where active = true
        <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())? (Order())? (Page())?
        {
            return new GetSymbol(null, timestamp);
        }
      |
        // No keys + preposition — get from 1 / get from [1, 2]
        (<FROM> | <IN> | <WITHIN>)
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection() (timestamp=TimestampReadCommand())? (Order())? (Page())?
            {
                return new GetSymbol(null, records, timestamp);
            }
          |
            record=<NUMERIC> (timestamp=TimestampReadCommand())? (Order())? (Page())?
            {
                return new GetSymbol(null, Long.parseLong(record.image), timestamp);
            }
        )
      |
        // Bracketed record collection (no keys) — get [1, 2, 3]
        LOOKAHEAD(<OPEN_BRACKET> <NUMERIC>)
        records=RecordCollection() (timestamp=TimestampReadCommand())?
        {
            return new GetSymbol(null, records, timestamp);
        }
      |
        // Bracketless record collection (no keys) — get 1, 2, 3
        LOOKAHEAD(<NUMERIC> <COMMA>)
        records=RecordCollection() (timestamp=TimestampReadCommand())?
        {
            return new GetSymbol(null, records, timestamp);
        }
      |
        // Single record (no keys) — get 1
        record=<NUMERIC> (timestamp=TimestampReadCommand())?
        {
            return new GetSymbol(null, Long.parseLong(record.image), timestamp);
        }
    )
}

