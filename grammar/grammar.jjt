CommandSymbol JsonifyCommand() : {
    Token record = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp = null;
    boolean identifier = false;
}
{
    <JSONIFY>
    (
        LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
        records=RecordCollection()
      |
        record=<NUMERIC>
    )
    (<WITH> <RESERVED_IDENTIFIER> { identifier = true; })?
    (timestamp=TimestampReadCommand())?
    {
        if(record != null) {
            return new JsonifySymbol(Long.parseLong(record.image), null, timestamp, identifier);
        } else {
            return new JsonifySymbol(null, records, timestamp, identifier);
        }
    }
}

CommandSymbol NavigateCommand() : {
    KeyTokenSymbol<?> key = null;
    Collection<KeyTokenSymbol<?>> keys = null;
    Token record = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp = null;
}
{
    <NAVIGATE>
    (
        LOOKAHEAD( <OPEN_BRACKET> | Key() <COMMA> )
        keys=KeyCollection()
      |
        key=Key()
        {
            keys = new ArrayList<KeyTokenSymbol<?>>();
            keys.add(key);
        }
    )
    (
        (<WHERE> DisjunctionExpression()) (timestamp=TimestampReadCommand())?
        { return new NavigateSymbol(keys, (String)null, timestamp); }
      |
        (<FROM> | <IN> | <WITHIN>)
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection() (timestamp=TimestampReadCommand())?
            { return new NavigateSymbol(keys, records, timestamp); }
          |
            record=<NUMERIC> (timestamp=TimestampReadCommand())?
            { return new NavigateSymbol(keys, Long.parseLong(record.image), timestamp); }
        )
    )
}

CommandSymbol ReconcileCommand() : {
    KeyTokenSymbol<?> key;
    Token record;
    Collection<ValueTokenSymbol<?>> values;
}
{
    <RECONCILE> key=Key() (<IN> | <WITHIN>) record=<NUMERIC> <WITH> values=ValueCollection()
    { return new ReconcileSymbol(key, Long.parseLong(record.image), values); }
}

CommandSymbol AuditCommand() : {
    KeyTokenSymbol<?> key = null;
    Token record;
    TimestampSymbol start = null;
    TimestampSymbol end = null;
}
{
    <AUDIT>
    (
        LOOKAHEAD(2)
        key=Key() (<IN> | <WITHIN>)
    )?
    record=<NUMERIC>
    (
        <FROM> start=TimestampValue() <TO> end=TimestampValue()
    )?
    { return new AuditSymbol(key, Long.parseLong(record.image), start, end); }
}

CommandSymbol TraceCommand() : {
    Token record = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp = null;
}
{
    <TRACE>
    (
        LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
        records=RecordCollection() (timestamp=TimestampReadCommand())?
        { return new TraceSymbol(records, timestamp); }
      |
        record=<NUMERIC> (timestamp=TimestampReadCommand())?
        { return new TraceSymbol(Long.parseLong(record.image), timestamp); }
    )
}

// Transaction Operations
CommandSymbol TransactionOperations() : {
    CommandSymbol cmd;
}
{
    (
        cmd = StageCommand()
      |
        cmd = CommitCommand()
      |
        cmd = AbortCommand()
    )
    { return cmd; }
}

CommandSymbol StageCommand() : {}
{
    <STAGE>
    { return StageSymbol.INSTANCE; }
}

CommandSymbol CommitCommand() : {}
{
    <COMMIT>
    { return CommitSymbol.INSTANCE; }
}

CommandSymbol AbortCommand() : {}
{
    <ABORT>
    { return AbortSymbol.INSTANCE; }
}

CommandSymbol RevertCommand() : {
    KeyTokenSymbol<?> key = null;
    Token record = null;
    Collection<KeyTokenSymbol<?>> keys = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp;
}
{
    <REVERT>
    (
        LOOKAHEAD(KeyCollection() (<IN> | <WITHIN>))
        keys=KeyCollection() (<IN> | <WITHIN>)
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection()
            timestamp=TimestampReadCommand()
            { return new RevertSymbol(keys, records, timestamp); }
          |
            record=<NUMERIC>
            timestamp=TimestampReadCommand()
            { return new RevertSymbol(keys, Long.parseLong(record.image), timestamp); }
        )
      |
        key=Key() (<IN> | <WITHIN>)
        (
            LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
            records=RecordCollection()
            timestamp=TimestampReadCommand()
            { return new RevertSymbol(key, records, timestamp); }
          |
            record=<NUMERIC>
            timestamp=TimestampReadCommand()
            { return new RevertSymbol(key, Long.parseLong(record.image), timestamp); }
        )
    )
}

// Utility Operations
CommandSymbol UtilityOperations() : {
    CommandSymbol cmd;
}
{
    (
        cmd = PingCommand()
      |
        cmd = HoldsCommand()
      |
        cmd = ConsolidateCommand()
      |
        cmd = CalculateCommand()
    )
    { return cmd; }
}

CommandSymbol PingCommand() : {}
{
    <PING>
    { return PingSymbol.INSTANCE; }
}

CommandSymbol HoldsCommand() : {
    Token record;
    Collection<Long> records;
}
{
    <HOLDS>
    (
        LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
        records=RecordCollection()
        { return new HoldsSymbol(records); }
      |
        record=<NUMERIC>
        { return new HoldsSymbol(Long.parseLong(record.image)); }
    )
}

CommandSymbol ConsolidateCommand() : {
    Token first;
    Token second;
    Collection<Long> remaining = null;
}
{
    <CONSOLIDATE> first=<NUMERIC>
    (
        LOOKAHEAD( <OPEN_BRACKET> | <NUMERIC> <COMMA> )
        remaining=RecordCollection()
        { return new ConsolidateSymbol(Long.parseLong(first.image), remaining); }
      |
        second=<NUMERIC>
        {
            Collection<Long> others = new ArrayList<Long>();
            others.add(Long.parseLong(second.image));
            return new ConsolidateSymbol(Long.parseLong(first.image), others);
        }
    )
}

CommandSymbol CalculateCommand() : {
    Token function;
    KeyTokenSymbol<?> key;
    Token record = null;
    Collection<Long> records = null;
    TimestampSymbol timestamp = null;
}
{
    <CALCULATE> function=<ALPHANUMERIC> key=Key()
    (
        LOOKAHEAD((<FROM> | <IN> | <WITHIN>) (<OPEN_BRACKET> | <NUMERIC> <COMMA>))
        (<FROM> | <IN> | <WITHIN>) records=RecordCollection() (timestamp=TimestampReadCommand())?
        { return new CalculateSymbol(function.image, key, records, timestamp); }
      |
        LOOKAHEAD((<FROM> | <IN> | <WITHIN>) <NUMERIC>)
        (<FROM> | <IN> | <WITHIN>) record=<NUMERIC> (timestamp=TimestampReadCommand())?
        {
            records = new ArrayList<Long>();
            records.add(Long.parseLong(record.image));
            return new CalculateSymbol(function.image, key, records, timestamp);
        }
      |
        <WHERE> DisjunctionExpression() (timestamp=TimestampReadCommand())?
        { return new CalculateSymbol(function.image, key, timestamp); }
      |
        (timestamp=TimestampReadCommand())?
        { return new CalculateSymbol(function.image, key, timestamp); }
    )
}

// Utility parsing rules
Collection<ValueTokenSymbol<?>> ValueCollection() : {
    ValueTokenSymbol<?> value;
    Collection<ValueTokenSymbol<?>> values = Lists.newArrayList();
}
{
    (
        <OPEN_BRACKET>
            value=UnaryValue() { values.add(value); }
            (<COMMA> value=UnaryValue() { values.add(value); })*
        <CLOSE_BRACKET>
      |
        value=UnaryValue() { values.add(value); }
        (<COMMA> value=UnaryValue() { values.add(value); })+
    )
    { return values; }
}

Collection RecordCollection() :
{
    Token record;
    Collection records = new ArrayList();
}
{
    (
        <OPEN_BRACKET>
            record=<NUMERIC> { records.add(Long.parseLong(record.image)); }
            (<COMMA> record=<NUMERIC> { records.add(Long.parseLong(record.image)); })*
        <CLOSE_BRACKET>
      |
        record=<NUMERIC> { records.add(Long.parseLong(record.image)); }
        (<COMMA> record=<NUMERIC> { records.add(Long.parseLong(record.image)); })+
    )
    { return records; }
}

Collection KeyCollection() :
{
    KeyTokenSymbol key;
    Collection keys = new ArrayList();
}
{
    (
        <OPEN_BRACKET>
            key=Key() { keys.add(key); }
            (<COMMA> key=Key() { keys.add(key); })*
        <CLOSE_BRACKET>
      |
        key=Key() { keys.add(key); }
        (<COMMA> key=Key() { keys.add(key); })+
    )
    { return keys; }
}

String JsonObject() :
{
    Token content;
}
{
    content=<QUOTED_STRING>
    { return content.image; }
}
